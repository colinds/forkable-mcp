{
  "name": "forkable-mcp-workspace",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@modelcontextprotocol/ext-apps": "2.0.3",
      "@openai/mcp-extensions": "0.2.0",
      "zod": "^4.6.7",
      "@modelcontextprotocol/client": "^2.3.1",
      "@types/bun": "^1.4.3",
      "typescript": "^7.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "start": "bun run build && bun run apps/mcp/src/index.ts",
    "dev": "bun run scripts/dev.ts",
    "auth": "bun run apps/mcp/src/index.ts --auth",
    "test": "bun test",
    "test:tz": "TZ=Asia/Kolkata bun test",
    "typecheck": "tsc --noEmit && bun run --workspaces typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt apps packages tests scripts package.json tsconfig.json .oxlintrc.json",
    "fmt:check": "oxfmt --check apps packages tests scripts package.json tsconfig.json .oxlintrc.json",
    "smoke": "bun run scripts/smoke.ts",
    "check": "oxlint && bun run fmt:check && bun run typecheck && bun test && bun run test:tz",
    "test:browser": "bun run --filter @forkable-mcp/app test:browser"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "@types/bun": "catalog:",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "catalog:"
  }
}
