{
  "name": "forkable-mcp",
  "type": "module",
  "version": "0.6.1",
  "description": "Unofficial MCP server for Forkable — order and manage corporate lunches from any MCP client.",
  "license": "MIT",
  "author": "Colin D'Souza",
  "homepage": "https://github.com/colinds/forkable-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colinds/forkable-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/colinds/forkable-mcp/issues"
  },
  "keywords": ["mcp", "model-context-protocol", "forkable", "lunch", "bun", "node"],
  "bin": {
    "forkable-mcp": "dist/index.js"
  },
  "files": ["dist", "skills", "README.md", "LICENSE"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bun build src/index.ts --target=node --format=esm --packages=external --outfile=dist/index.js",
    "prepack": "bun run build",
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "auth": "bun run src/index.ts --auth",
    "test": "bun test",
    "test:tz": "TZ=Asia/Kolkata bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt src tests scripts",
    "fmt:check": "oxfmt --check src tests scripts",
    "smoke": "bun run scripts/smoke.ts",
    "check": "oxlint && oxfmt --check src tests scripts && tsc --noEmit && bun test && bun run test:tz"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "@steipete/sweet-cookie": "^0.4.1",
    "cookie": "^2.0.1",
    "set-cookie-parser": "^3.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2"
  }
}
