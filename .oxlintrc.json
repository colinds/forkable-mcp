{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-nested-ternary": "error",
    "no-unused-vars": "warn",
    "eqeqeq": ["error", "smart"]
  },
  "ignorePatterns": ["node_modules", "exploration", "dist"]
}
