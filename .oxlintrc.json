{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-nested-ternary": "error",
    "no-unused-vars": "warn",
    "eqeqeq": ["error", "smart"],
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": ["node_modules", "exploration", "dist"],
  "overrides": [
    {
      "files": ["apps/app/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["node:*", "bun", "@/server/**", "**/server/**"]
          }
        ],
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "error"
      }
    },
    {
      "files": ["src/server/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["@/app/**", "**/app/**", "@forkable/app/**"]
          }
        ]
      }
    },
    {
      "files": ["packages/shared/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "node:*",
              "bun",
              "@/server/**",
              "**/server/**",
              "@/app/**",
              "**/app/**",
              "@forkable/app/**"
            ]
          }
        ]
      }
    }
  ],
  "plugins": ["unicorn", "typescript", "oxc", "react"]
}
