{
  "name": "forkable-mcp",
  "version": "0.8.0",
  "description": "Unofficial MCP server for Forkable — order and manage corporate lunches from any MCP client.",
  "keywords": [
    "bun",
    "food",
    "forkable",
    "lunch",
    "mcp",
    "model-context-protocol",
    "node",
    "ordering"
  ],
  "homepage": "https://github.com/colinds/forkable-mcp#readme",
  "bugs": {
    "url": "https://github.com/colinds/forkable-mcp/issues"
  },
  "license": "MIT",
  "author": "Colin D'Souza",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colinds/forkable-mcp.git"
  },
  "bin": {
    "forkable-mcp": "dist/index.js"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@modelcontextprotocol/ext-apps": "2.0.3",
      "@openai/mcp-extensions": "0.2.0",
      "zod": "^4.6.7",
      "@modelcontextprotocol/client": "^2.3.1",
      "@types/bun": "^1.4.3",
      "typescript": "^7.0.2"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "prepack": "bun run build",
    "start": "bun run build && bun run src/index.ts",
    "dev": "bun run scripts/dev.ts",
    "auth": "bun run src/index.ts --auth",
    "test": "bun test",
    "test:tz": "TZ=Asia/Kolkata bun test",
    "typecheck": "tsc --noEmit && bun run --workspaces typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt src apps packages tests scripts package.json tsconfig.json .oxlintrc.json",
    "fmt:check": "oxfmt --check src apps packages tests scripts package.json tsconfig.json .oxlintrc.json",
    "smoke": "bun run scripts/smoke.ts",
    "check": "oxlint && bun run fmt:check && bun run typecheck && bun test && bun run test:tz",
    "test:browser": "bun run --filter @forkable-mcp/app test:browser"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "catalog:",
    "@modelcontextprotocol/server": "^2.3.1",
    "@openai/mcp-extensions": "catalog:",
    "@steipete/sweet-cookie": "^0.4.4",
    "cookie": "^2.0.1",
    "set-cookie-parser": "^3.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@forkable-mcp/shared": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/bun": "catalog:",
    "lucide-static": "^1.59.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
